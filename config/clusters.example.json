{
  "default_cluster": "trillium",
  "clusters": {
    "trillium": {
      "ssh_alias": "trillium",
      "host": "trillium.alliancecan.ca",
      "user": "YOUR_ALLIANCE_USERNAME",
      "scratch_dir": "/scratch/{user}",
      "project_dir": "/project/YOUR_PROJECT_GROUP/{user}",
      "remote_project_dir": "/scratch/{user}/research-workspace",
      "account": "YOUR_SLURM_ACCOUNT",
      "sbatch_defaults": [
        "--account={account}",
        "--time=01:00:00",
        "--cpus-per-task=4",
        "--mem=8G"
      ]
    },
    "narval-gpu": {
      "ssh_alias": "narval",
      "host": "narval.alliancecan.ca",
      "user": "YOUR_ALLIANCE_USERNAME",
      "scratch_dir": "/scratch/{user}",
      "project_dir": "/project/YOUR_PROJECT_GROUP/{user}",
      "remote_project_dir": "/scratch/{user}/research-workspace",
      "account": "YOUR_SLURM_ACCOUNT",
      "sbatch_defaults": [
        "--account={account}",
        "--gres=gpu:a100:1",
        "--cpus-per-task=8",
        "--mem=32G",
        "--time=02:00:00"
      ]
    },
    "nibi-gpu": {
      "ssh_alias": "nibi",
      "host": "nibi.alliancecan.ca",
      "user": "YOUR_ALLIANCE_USERNAME",
      "scratch_dir": "/scratch/{user}",
      "project_dir": "/project/YOUR_PROJECT_GROUP/{user}",
      "remote_project_dir": "/scratch/{user}/research-workspace",
      "account": "YOUR_SLURM_ACCOUNT",
      "sbatch_defaults": [
        "--account={account}",
        "--gres=gpu:h100:1",
        "--cpus-per-task=12",
        "--mem=64G",
        "--time=03:00:00"
      ]
    }
  }
}

