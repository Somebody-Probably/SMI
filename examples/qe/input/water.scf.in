&control
  calculation = 'scf'
  prefix = 'water'
  pseudo_dir = './pseudo'
  outdir = './tmp'
/
&system
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 30.0
  occupations = 'fixed'
/
&electrons
  conv_thr = 1.0d-8
  electron_maxstep = 80
/
ATOMIC_SPECIES
 O 15.999 O.upf
 H 1.008 H.upf
ATOMIC_POSITIONS angstrom
 O  0.000000  0.000000  0.000000
 H  0.758602  0.000000  0.504284
 H -0.758602  0.000000  0.504284
K_POINTS gamma
CELL_PARAMETERS angstrom
 12.000000  0.000000  0.000000
  0.000000 12.000000  0.000000
  0.000000  0.000000 12.000000
